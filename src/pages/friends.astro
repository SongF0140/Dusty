---
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import Comment from "@components/comment/index.astro";
import ImageWrapper from "@components/common/ImageWrapper.astro";
import { commentConfig, friendsPageConfig, getEnabledFriends, profileConfig, siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";
import { isGithubCommentsConfigured } from "@/utils/github-comments";
import "../styles/friends.css";

if (!siteConfig.pages.friends) return Astro.redirect("/404/");
const friendsPost = await getEntry("spec", "friends");
const items = getEnabledFriends();
const nodes = items.map((friend, index) => {
    const angle = (-110 + index * 360 / items.length) * Math.PI / 180;
    return { ...friend, x: 50 + Math.cos(angle) * 38, y: 50 + Math.sin(angle) * 36 };
});
const siteHost = Astro.site?.hostname || "mjzy.tech";
const isCommentEnabled = commentConfig.type !== "none" && friendsPageConfig.showComment !== false;
const canUseComments = isCommentEnabled && (commentConfig.type !== "giscus" || isGithubCommentsConfigured(commentConfig.giscus));
const initialPreview = [
    'site: "我的博客"', 'url: "https://your-site.com"', 'owner: "你的昵称"',
    'desc: "用一句话介绍你的网站…"', 'image: "https://your-site.com/avatar.jpg"', 'color: "#8cae91"',
].join("\n");
---

<MainGridLayout title="友情链接" description="一步一个脚印，让我们一起成长🌟">
    <friends-directory class="friends-page card-base">
        <header class="friends-heading">
            <h1>Friend Links</h1>
            <p class="friends-summary">一步一个脚印，让我们一起成长🌟</p>
        </header>
        <div class="friends-constellation" role="group" aria-label="朋友与我的连接">
            <svg class="friend-connections" viewBox="0 0 1000 650" preserveAspectRatio="none" aria-hidden="true">
                {nodes.map(node => <line x1="500" y1="325" x2={node.x * 10} y2={node.y * 6.5} />)}
            </svg>
            <a class="friend-center" href={url("/about/")} aria-label={`关于 ${profileConfig.name}`}>
                <div class="friend-center-portrait"><ImageWrapper src={profileConfig.avatar || "assets/images/profile/author-portrait.png"} alt={profileConfig.name} loading="eager" widths={[160, 320]} sizes="144px" /></div>
                <span>{siteHost}</span>
            </a>
            {nodes.map((node, index) => (
                <a class:list={["friend-node", { "friend-node-right": node.x > 65, "friend-node-left": node.x < 35, "friend-node-top": node.y < 30 }]} style={`--node-x:${node.x}%;--node-y:${node.y}%;`} href={node.siteurl} target="_blank" rel="noopener noreferrer" aria-label={`访问 ${node.title}`} aria-describedby={`friend-info-${index}`} data-swup-ignore>
                    <span class="friend-node-portrait"><span aria-hidden="true">{node.title.slice(0, 1)}</span><img src={node.imgurl} alt="" loading="lazy" referrerpolicy="no-referrer" /></span>
                    <span class="friend-node-info" id={`friend-info-${index}`} role="tooltip">
                        <strong>{node.title}</strong>
                        {node.owner && <span class="friend-node-owner">{node.owner}</span>}
                        <span class="friend-node-description">{node.desc}</span>
                        <span class="friend-node-category">{node.category || "友链小伙伴"}</span>
                        <span class="friend-node-domain">{new URL(node.siteurl).hostname}<span aria-hidden="true">↗</span></span>
                    </span>
                </a>
            ))}
        </div>
        <p class="friends-count">{items.length} 位朋友</p>

        {friendsPageConfig.showCustomContent !== false && (
            <section class="friend-application" aria-labelledby="friend-application-heading">
                <div class="friend-application-form">
                    <h2 id="friend-application-heading"><Icon name="material-symbols:add-link-rounded" />申请友链</h2>
                    <p>填写你的网站信息，右侧会生成可复制的配置。</p>
                    <form data-friend-form autocomplete="off">
                        <label>站点名称<input name="site" placeholder="我的博客" maxlength="80" /></label>
                        <label>昵称<input name="owner" placeholder="你的昵称" maxlength="60" /></label>
                        <label class="friend-field-wide">站点地址<input name="url" type="url" placeholder="https://your-site.com" /></label>
                        <label class="friend-field-wide">站点简介<input name="desc" placeholder="用一句话介绍你的网站…" maxlength="200" /></label>
                        <label>头像链接<input name="image" type="url" placeholder="https://…" /></label>
                        <label>主题色<span class="friend-color-field"><input name="color" type="color" value="#8cae91" /><output data-color-value>#8cae91</output></span></label>
                    </form>
                </div>
                <div class="friend-config-panel">
                    <div class="friend-config-heading"><h3>配置预览</h3><button type="button" data-copy-friend><Icon name="material-symbols:content-copy-outline-rounded" /><span>复制配置</span></button></div>
                    <pre><code data-friend-preview>{initialPreview}</code></pre>
                    {canUseComments && <p class="friend-application-note">复制配置后，在下方评论区留言，确认后会添加你的友链。</p>}
                    {!canUseComments && <p class="friend-application-note">评论区暂未开启。复制配置后，可通过 <a href={url("/about/")}>About 页的联系方式</a>发给我。</p>}
                    <p class="friend-copy-status" data-copy-status role="status" aria-live="polite"></p>
                </div>
            </section>
        )}
    </friends-directory>
    {isCommentEnabled && friendsPost && <div class="mt-6"><Comment post={friendsPost} customPath="/friends/" /></div>}
</MainGridLayout>

<script>
class FriendsDirectory extends HTMLElement {
    private controller?: AbortController;
    connectedCallback() {
        this.controller?.abort();
        this.controller = new AbortController();
        const { signal } = this.controller;
        const form = this.querySelector<HTMLFormElement>("[data-friend-form]");
        const preview = this.querySelector<HTMLElement>("[data-friend-preview]");
        const status = this.querySelector<HTMLElement>("[data-copy-status]");
        const defaults: Record<string, string> = { site: "我的博客", url: "https://your-site.com", owner: "你的昵称", desc: "用一句话介绍你的网站…", image: "https://your-site.com/avatar.jpg", color: "#8cae91" };
        const updatePreview = () => {
            if (!form || !preview) return;
            const data = new FormData(form);
            preview.textContent = Object.entries(defaults).map(([key, fallback]) => `${key}: ${JSON.stringify(String(data.get(key) || "").trim() || fallback)}`).join("\n");
            const color = this.querySelector("[data-color-value]");
            if (color) color.textContent = String(data.get("color"));
            if (status) status.textContent = "";
        };
        form?.addEventListener("input", updatePreview, { signal });
        form?.addEventListener("submit", event => event.preventDefault(), { signal });
        this.addEventListener("click", async event => {
            const target = event.target instanceof Element ? event.target : null;
            const node = target?.closest<HTMLAnchorElement>(".friend-node");
            if (node && matchMedia("(hover: none)").matches && !node.classList.contains("friend-node-open")) {
                event.preventDefault();
                this.querySelectorAll(".friend-node-open").forEach(item => item.classList.remove("friend-node-open"));
                node.classList.add("friend-node-open");
            }
            const copy = target?.closest<HTMLButtonElement>("[data-copy-friend]");
            if (copy && preview && status) {
                try {
                    await navigator.clipboard.writeText(preview.textContent || "");
                    status.textContent = "配置已复制，可以发送给站长了。";
                } catch {
                    status.textContent = "未能复制，请选中上方配置后手动复制。";
                }
            }
        }, { signal });
        document.addEventListener("pointerdown", event => {
            if (!(event.target instanceof Element) || !event.target.closest(".friend-node"))
                this.querySelectorAll(".friend-node-open").forEach(item => item.classList.remove("friend-node-open"));
        }, { signal });
        this.querySelectorAll<HTMLImageElement>(".friend-node img").forEach(image => {
            const failed = () => { image.hidden = true; };
            image.addEventListener("error", failed, { signal });
            if (image.complete && !image.naturalWidth) failed();
        });
    }
    disconnectedCallback() { this.controller?.abort(); }
}
if (!customElements.get("friends-directory")) customElements.define("friends-directory", FriendsDirectory);
</script>
