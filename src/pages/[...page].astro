---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import Pagination from "@/components/common/Pagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryList, getSortedPosts } from "@/utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	// 使用配置中的文章数量
	const pageSize = siteConfig.pagination.postsPerPage;
	return paginate(allBlogPosts, { pageSize });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
const categories = await getCategoryList();
const totalPosts = categories.reduce((sum, category) => sum + category.count, 0);
const isHome = page.currentPage === 1;

const categoryMeta: Record<
	string,
	{ icon: string; description: string; tone: string; accent: string }
> = {
	物联网: {
		icon: "material-symbols:computer-outline",
		description: "ESP32-S3、外设驱动、通信协议与 FreeRTOS 实战笔记。",
		tone: "green",
		accent: "#9aa78b",
	},
	数据结构: {
		icon: "material-symbols:folder-open-rounded",
		description: "链表、栈、队列、树与图搜索，把基础结构拆到可实现。",
		tone: "blue",
		accent: "#a29b84",
	},
	深度学习: {
		icon: "material-symbols:article-outline",
		description: "全连接网络、卷积网络与模型结构学习记录。",
		tone: "yellow",
		accent: "#c3ae7f",
	},
	计算机组成原理: {
		icon: "material-symbols:computer-outline",
		description: "从晶体管到 CPU 执行流程，整理计算机底层运行逻辑。",
		tone: "green",
		accent: "#8f9e90",
	},
	Linux编程: {
		icon: "material-symbols:build-outline",
		description: "进程、多进程编程与操作系统接口相关实践。",
		tone: "blue",
		accent: "#9b9078",
	},
	算法题解: {
		icon: "material-symbols:tag-rounded",
		description: "洛谷题解与算法思路复盘，关注可解释的解法路径。",
		tone: "yellow",
		accent: "#c7b27b",
	},
};

const fallbackTones = ["green", "blue", "yellow"];
const getMeta = (name: string, index: number) =>
	categoryMeta[name] ?? {
		icon: "material-symbols:folder-open-rounded",
		description: "持续整理中的学习笔记与项目记录。",
		tone: fallbackTones[index % fallbackTones.length],
		accent: ["#9aa78b", "#a29b84", "#c3ae7f"][index % 3],
	};
---

<MainGridLayout>
  {
    isHome ? (
      <section class="home-category-board onload-animation">
        <div class="home-category-hero glass-panel">
          <p class="eyebrow">札记 · 领域</p>
          <h1>从领域进入我的札记</h1>
          <p class="hero-copy">
            这里不再默认堆最新文章，而是按领域进入：嵌入式、数据结构、深度学习、计算机底层与算法记录。
          </p>
          <div class="hero-stats" aria-label="站点内容统计">
            <span>{categories.length} 个领域</span>
            <span>{totalPosts} 篇札记</span>
          </div>
        </div>

        <div class="category-section-grid">
          {categories.map((category, index) => {
            const meta = getMeta(category.name, index);
            return (
              <a
                href={category.url}
                class={`category-section-card glass-panel tone-${meta.tone}`}
                style={`--accent: ${meta.accent}; animation-delay: calc(var(--content-delay) + ${index * 60}ms);`}
              >
                <div class="card-glow" aria-hidden="true" />
                <div class="card-topline">
                  <span class="section-icon">
                    <Icon is:inline name={meta.icon} />
                  </span>
                  <span class="section-count">{category.count} 篇札记</span>
                </div>
                <h2>{category.name}</h2>
                <p>{meta.description}</p>
                <div class="section-action">
                  <span>进入领域</span>
                  <Icon is:inline name="material-symbols:chevron-right-rounded" />
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ) : (
      <>
        <PostPage page={page} />
        {page.total > page.size && (
          <Pagination
            class="mx-auto onload-animation"
            page={page}
            style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
          />
        )}
      </>
    )
  }
</MainGridLayout>

<style>
  .home-category-board {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: clamp(0.65rem, 2vw, 1rem);
    border: 1px solid rgba(98, 78, 52, 0.18);
    border-radius: 1.25rem;
    background:
      radial-gradient(circle at 18% 8%, rgba(255, 252, 238, 0.92), transparent 28%),
      radial-gradient(circle at 88% 18%, rgba(191, 146, 83, 0.16), transparent 30%),
      linear-gradient(135deg, rgba(247, 238, 214, 0.96), rgba(226, 210, 176, 0.9));
    box-shadow:
      0 26px 70px rgba(80, 58, 34, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.72);
  }

  .glass-panel {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--accent, #9aa78b) 44%, #8a6f4d 18%);
    background:
      linear-gradient(135deg, rgba(255, 253, 246, 0.76), rgba(236, 223, 194, 0.44)),
      color-mix(in oklab, var(--accent, #9aa78b) 11%, rgba(250, 244, 229, 0.78));
    box-shadow:
      0 16px 38px rgba(81, 59, 35, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.66),
      inset 0 -1px 0 rgba(93, 67, 39, 0.06);
    backdrop-filter: blur(18px) saturate(1.08);
    -webkit-backdrop-filter: blur(18px) saturate(1.08);
  }

  .home-category-hero {
    --accent: #9aa78b;
    padding: clamp(1.45rem, 3vw, 2.45rem);
    border-radius: 1rem;
  }

  .home-category-hero::before,
  .home-category-hero::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .home-category-hero::before {
    inset: 0.85rem;
    border: 1px solid rgba(111, 83, 48, 0.14);
    border-radius: 0.72rem;
  }

  .home-category-hero::after {
    width: 14rem;
    height: 14rem;
    right: -4rem;
    top: -5rem;
    border-radius: 999px;
    background: rgba(122, 88, 49, 0.1);
    filter: blur(34px);
  }

  .eyebrow {
    position: relative;
    z-index: 1;
    color: #8b6a3f;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .home-category-hero h1 {
    position: relative;
    z-index: 1;
    color: #2f2419;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -0.04em;
    margin: 0;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    color: #6f5b40;
    line-height: 1.85;
    margin: 0.9rem 0 0;
  }

  .hero-stats {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.25rem;
  }

  .hero-stats span {
    border: 1px solid rgba(117, 91, 58, 0.2);
    border-radius: 999px;
    padding: 0.42rem 0.8rem;
    color: #735a3a;
    background: rgba(255, 251, 238, 0.48);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.68);
    font-size: 0.86rem;
  }

  .category-section-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .category-section-card {
    min-height: 14rem;
    border-radius: 1rem;
    padding: 1.2rem;
    color: #463626;
    text-decoration: none;
    transform: translateY(0);
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease,
      background 220ms ease;
  }

  .category-section-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklab, var(--accent) 72%, #8a6f4d);
    box-shadow:
      0 24px 58px rgba(73, 54, 31, 0.16),
      0 0 0 1px color-mix(in oklab, var(--accent) 18%, transparent);
  }

  .tone-green {
    --accent: #9aa78b;
  }

  .tone-blue {
    --accent: #a29b84;
  }

  .tone-yellow {
    --accent: #c3ae7f;
  }

  .card-glow {
    position: absolute;
    right: -3.5rem;
    top: -3.5rem;
    width: 9rem;
    height: 9rem;
    border-radius: 999px;
    background: var(--accent);
    opacity: 0.16;
    filter: blur(26px);
  }

  .card-topline {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-icon {
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in oklab, var(--accent) 42%, #7a5b36 20%);
    border-radius: 0.85rem;
    color: color-mix(in oklab, var(--accent) 58%, #4a3421);
    background:
      linear-gradient(145deg, rgba(255, 251, 238, 0.82), rgba(205, 183, 141, 0.28));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 7px 16px rgba(73, 54, 31, 0.1);
    font-size: 1.55rem;
  }

  .section-count {
    border: 1px solid rgba(117, 91, 58, 0.18);
    border-radius: 999px;
    padding: 0.32rem 0.66rem;
    color: #765f43;
    background: rgba(255, 251, 238, 0.46);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .category-section-card h2 {
    position: relative;
    z-index: 1;
    margin: 1.15rem 0 0;
    color: #342719;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.35rem;
    line-height: 1.18;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .category-section-card p {
    position: relative;
    z-index: 1;
    min-height: 4.2rem;
    color: #735f43;
    line-height: 1.72;
    margin: 0.65rem 0 1rem;
    font-size: 0.92rem;
  }

  .section-action {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: color-mix(in oklab, var(--accent) 54%, #5b3f24);
    font-weight: 800;
    font-size: 0.9rem;
  }

  .section-action :global(svg) {
    font-size: 1.15rem;
    transition: transform 180ms ease;
  }

  .category-section-card:hover .section-action :global(svg) {
    transform: translateX(3px);
  }

  @media (max-width: 1024px) {
    .category-section-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .home-category-hero,
    .category-section-card {
      border-radius: 1rem;
    }

    .category-section-grid {
      grid-template-columns: 1fr;
    }

    .category-section-card {
      min-height: 12.5rem;
    }
  }
</style>

<script>
  // 响应式分页处理脚本
  document.addEventListener("DOMContentLoaded", function () {
    // 如果启用了响应式分页，添加相应的CSS类
    const responsiveEnabled = true; // ${siteConfig.pagination.responsive}
    if (responsiveEnabled) {
      const deviceType = getDeviceType();
      document.body.classList.add(`device-${deviceType}`);

      // 监听窗口大小变化
      let resizeTimeout: any;
      window.addEventListener("resize", function () {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(function () {
          const newDeviceType = getDeviceType();
          const currentDeviceType = document.body.className.match(
            /device-(mobile|tablet|desktop)/
          )?.[1];

          if (currentDeviceType !== newDeviceType) {
            document.body.classList.remove(`device-${currentDeviceType}`);
            document.body.classList.add(`device-${newDeviceType}`);
          }
        }, 250);
      });
    }
  });

  function getDeviceType() {
    if (typeof window === "undefined") return "desktop";

    const width = window.innerWidth;
    if (width < 768) return "mobile";
    if (width < 1024) return "tablet";
    return "desktop";
  }
</script>
