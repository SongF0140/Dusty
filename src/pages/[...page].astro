---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import Pagination from "@/components/common/Pagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryList, getSortedPosts } from "@/utils/content-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	// 使用配置中的文章数量
	const pageSize = siteConfig.pagination.postsPerPage;
	return paginate(allBlogPosts, { pageSize });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
const categories = await getCategoryList();
const totalPosts = categories.reduce((sum, category) => sum + category.count, 0);
const isHome = page.currentPage === 1;
const recentPosts = isHome
	? (await getSortedPosts())
		.slice()
		.sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
		.slice(0, 5)
	: [];


---

<MainGridLayout>
  {
    isHome ? (
      <>
      <section class="newspaper-welcome" aria-labelledby="newspaper-welcome-title">
        <div class="newspaper-dateline"><span>私人发行 · 不定期更新</span><span>已刊 {totalPosts} 篇</span></div>
        <header class="newspaper-title-row">
          <div class="newspaper-greeting">
            <h1 id="newspaper-welcome-title"><span>欢迎来到我的</span><span>秘密报社</span></h1>
            <p>把技术、灵感和生活里的发现，编进每一期手记。</p>
          </div>
          <figure class="article-list-mascot">
            <img src={url("/assets/images/retro-notebook.webp")} width="160" height="150" alt="挥手的笔记本吉祥物" fetchpriority="high" />
            <figcaption>CODE &amp; CURIOSITY</figcaption>
          </figure>
        </header>
        <nav class="newspaper-briefs" aria-label="报社导读">
          {recentPosts[0] && <a href={getPostUrlBySlug(recentPosts[0].id)}><span class="newspaper-column-label">本期导读</span><strong>{recentPosts[0].data.title}</strong><span>翻开最新一页 →</span></a>}
          <a href={url("/archive/")}><span class="newspaper-column-label">往期报纸</span><strong>{totalPosts} 篇文章存档</strong><span>从旧页里找新发现 →</span></a>
          <a href="#category-reading-title"><span class="newspaper-column-label">分栏索引</span><strong>{categories.length} 个阅读栏目</strong><span>按兴趣翻阅 →</span></a>
        </nav>
      </section>
      <section class="home-recent-posts" aria-labelledby="recent-posts-title">
        <header class="home-section-heading"><h2 id="recent-posts-title">文章列表</h2></header>
        <PostPage page={{ ...page, data: recentPosts }} />
        <a class="home-all-posts" href={url("/archive/")}>
          <span>查看全部文章</span>
          <Icon is:inline name="material-symbols:arrow-forward-rounded" />
        </a>
      </section>
      <section class="home-category-board onload-animation" aria-labelledby="category-reading-title">
        <header class="category-reading-heading">
          <span aria-hidden="true"></span>
          <h2 id="category-reading-title">分类阅读</h2>
          <span aria-hidden="true"></span>
        </header>
        <div class="category-section-grid">
          {categories.map((category, index) => (
            <a href={category.url} class="category-section-card">
              <span class="category-card-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3>{category.name}</h3>
              <span class="category-card-count">{category.count} 篇文章</span>
            </a>
          ))}
        </div>
      </section>
      </>
    ) : (
      <>
        <PostPage page={page} />
        {page.total > page.size && (
          <Pagination
            class="mx-auto onload-animation"
            page={page}
            style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
          />
        )}
      </>
    )
  }
</MainGridLayout>

<style>
  .home-recent-posts { margin-bottom: 2.5rem; }
  .newspaper-welcome {
    margin-bottom: 1.75rem;
    color: var(--retro-ink);
    border-bottom: 3px double var(--retro-outline);
    padding: 0.25rem 0.25rem 1.25rem;
  }
  .newspaper-dateline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--retro-outline);
    font-size: 0.75rem;
    color: var(--retro-muted);
    letter-spacing: 0.06em;
  }
  .newspaper-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.5rem 0;
  }
  .newspaper-greeting { min-width: 0; }
  .newspaper-greeting h1 {
    font-size: clamp(1.7rem, 3vw, 3rem);
    line-height: 1.3;
    font-weight: 900;
    text-wrap: balance;
  }
  .newspaper-greeting p {
    margin-top: 0.8rem;
    color: var(--retro-muted);
    font-size: 0.9rem;
    line-height: 1.7;
    max-width: 29rem;
  }
  .newspaper-greeting h1 span { display: inline-block; }
  .newspaper-briefs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--retro-outline);
    padding-top: 1rem;
  }
  .newspaper-briefs a {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
    padding: 0.25rem 1rem;
    text-decoration: none;
    color: var(--retro-ink);
    transition: background-color 150ms ease;
  }
  .newspaper-briefs a:first-child { padding-left: 0; }
  .newspaper-briefs a + a { border-left: 1px dashed var(--retro-muted); }
  .newspaper-briefs a:hover { background: color-mix(in srgb, var(--retro-sage) 45%, transparent); }
  .newspaper-column-label { color: var(--retro-green); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.15em; }
  .newspaper-briefs strong { font-size: 0.95rem; line-height: 1.5; }
  .newspaper-briefs a > span:last-child { color: var(--retro-muted); font-size: 0.7rem; }
  .home-section-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding: 0.5rem 0.25rem 1rem;
    border-bottom: 2px solid var(--retro-outline);
  }
  .home-section-heading h2 {
    color: var(--retro-ink);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 900;
    line-height: 1.2;
  }
  .article-list-mascot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    flex-shrink: 0;
  }
  .article-list-mascot img {
    width: clamp(5.5rem, 12vw, 9rem);
    height: auto;
    object-fit: contain;
  }
  .article-list-mascot figcaption {
    color: var(--retro-ink);
    font: 700 clamp(0.55rem, 1vw, 0.75rem)/1.4 "Courier New", monospace;
    white-space: nowrap;
  }
  .home-all-posts {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0.65rem 1rem;
    border: 2px solid var(--retro-outline);
    border-radius: var(--radius-large);
    background: var(--retro-surface);
    color: var(--retro-ink);
    font-weight: 800;
    box-shadow: 3px 3px 0 var(--retro-outline);
    transition: background-color 150ms ease;
  }
  .home-all-posts:hover { background: var(--retro-sage); }
  .home-all-posts :global(svg) { width: 1.1rem; height: 1.1rem; }
  .home-category-board { margin-bottom: 1rem; }
  .category-reading-heading {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
    color: var(--retro-ink);
  }
  .category-reading-heading > span {
    flex: 1;
    height: 1px;
    background: var(--retro-outline);
    opacity: 0.5;
  }
  .category-reading-heading h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    font-weight: 800;
    white-space: nowrap;
  }
  .category-section-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .home-category-board .category-section-card {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 2 / 1;
    min-height: 11rem;
    padding: 2.5rem 1.25rem;
    text-align: center;
    text-decoration: none;
    background-image:
      radial-gradient(var(--retro-texture) 0.7px, transparent 0.9px),
      linear-gradient(130deg, transparent 35%, color-mix(in srgb, var(--retro-surface) 35%, transparent));
    background-size: 4px 4px, 100% 100%;
  }
  .category-section-card h3 {
    color: var(--retro-ink);
    font-size: clamp(1.3rem, 2.3vw, 2rem);
    font-weight: 900;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .category-card-number, .category-card-count {
    position: absolute;
    font-size: 0.75rem;
    color: var(--retro-muted);
  }
  .category-card-number { top: 0.85rem; left: 1rem; font-family: monospace; }
  .category-card-count { bottom: 0.85rem; right: 1rem; }
  .category-section-card:focus-visible {
    outline: 3px solid var(--retro-green);
    outline-offset: 5px;
  }
  @media (max-width: 640px) {
    .newspaper-title-row { gap: 0.75rem; }
    .newspaper-greeting p { font-size: 0.8rem; }
    .newspaper-briefs { grid-template-columns: 1fr; padding-top: 0; }
    .newspaper-briefs a, .newspaper-briefs a:first-child { padding: 0.85rem 0; }
    .newspaper-briefs a + a { border-left: 0; border-top: 1px dashed var(--retro-muted); }
    .category-section-grid { grid-template-columns: 1fr; }
    .home-category-board .category-section-card { min-height: 10rem; }
  }
</style>

<script>
  // 响应式分页处理脚本
  document.addEventListener("DOMContentLoaded", function () {
    // 如果启用了响应式分页，添加相应的CSS类
    const responsiveEnabled = true; // ${siteConfig.pagination.responsive}
    if (responsiveEnabled) {
      const deviceType = getDeviceType();
      document.body.classList.add(`device-${deviceType}`);

      // 监听窗口大小变化
      let resizeTimeout: any;
      window.addEventListener("resize", function () {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(function () {
          const newDeviceType = getDeviceType();
          const currentDeviceType = document.body.className.match(
            /device-(mobile|tablet|desktop)/
          )?.[1];

          if (currentDeviceType !== newDeviceType) {
            document.body.classList.remove(`device-${currentDeviceType}`);
            document.body.classList.add(`device-${newDeviceType}`);
          }
        }, 250);
      });
    }
  });

  function getDeviceType() {
    if (typeof window === "undefined") return "desktop";

    const width = window.innerWidth;
    if (width < 768) return "mobile";
    if (width < 1024) return "tablet";
    return "desktop";
  }
</script>
