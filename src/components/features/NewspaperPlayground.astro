<script>import "@/scripts/newspaper-playground";</script>
<style is:global>
    newspaper-playground { display: none; }
    body:has(newspaper-playground) .home-section-heading { min-height: 94px; }
    .newspaper-playground { --doodle-opacity: .4; --doodle-paper: var(--retro-surface); position: fixed; inset: 0; z-index: 31; pointer-events: none; overflow: hidden; color: var(--retro-ink); }
    .newspaper-playground * { pointer-events: none; }
    .paper-doodle-definitions { position: absolute; }
    .paper-play-scene { position: absolute; overflow: visible; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; opacity: var(--doodle-opacity); transition: opacity 350ms ease; }
    .paper-play-scene[hidden] { display: none !important; }
    .paper-play-scene[data-paper-scene="gutter-right"] { opacity: .56; }
    .paper-play-scene.is-near { opacity: .62; }
    .doodle-paper { fill: var(--doodle-paper); }
    .doodle-white { fill: #fbf7eb; }
    .doodle-ink { fill: currentColor; stroke-width: 1.5; }
    .doodle-paint { filter: url(#paper-oil-edge); stroke-width: 1.4; }
    .doodle-swing-lean, .doodle-rope-lean { transform: rotate(var(--rope-lean, 7.5deg)); transition: transform 1400ms cubic-bezier(.2,.6,.3,1); }
    .doodle-swing-lean, .doodle-swing { transform-origin: 0 0; }
    .doodle-swing { animation: paper-gentle-swing 4.4s ease-in-out infinite alternate; }
    .doodle-rope-lean { transform-origin: 41px -52px; }
    .doodle-cloth { transform-box: fill-box; transform-origin: 50% 0; animation: paper-cloth 4s ease-in-out infinite alternate; }
    .doodle-bob { animation: paper-bob 4.8s ease-in-out infinite; }
    .doodle-dangle { transform-origin: 10px -40px; animation: paper-swing 5.2s ease-in-out infinite alternate; }
    .doodle-climb { animation: paper-climb 6s ease-in-out infinite; }
    .doodle-kite { transform-origin: 43px 78px; animation: paper-cloth 4.8s ease-in-out infinite alternate; }
