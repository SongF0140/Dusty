            <span class="assistant-connection">正在检查连接</span>
        </div>
                <animated-agent-avatar class="assistant-startup-avatar">
                    <button type="button" class="assistant-avatar-touch" aria-label="戳戳海问香" title="戳戳海问香">
                    <img src={url("/assets/images/assistant/haiwenxiang-avatar.png")} width="160" height="160" alt="海问香的 Q 版像素头像" decoding="async" />
