---
import { url } from "@/utils/url-utils";
---

<section id="navigation-assistant-panel" class="navigation-mode-panel assistant-panel" role="tabpanel" aria-labelledby="navigation-assistant-tab" hidden>
    <haiwenxiang-assistant>
