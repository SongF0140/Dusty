    </svg>
</template>
<template data-festive-sprite="candy">
    <svg viewBox="0 0 32 32" fill="none" stroke-linecap="round" aria-hidden="true">
        <path d="M10 28V10C10 1 24 1 24 10v3" stroke="#633c2d" stroke-width="8" />
        <path d="M10 28V10C10 1 24 1 24 10v3" stroke="#fff1d6" stroke-width="6" />
