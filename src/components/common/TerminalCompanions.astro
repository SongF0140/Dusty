---
import { getImage } from "astro:assets";
import haiwenxiang from "@/assets/images/navigation/haiwenxiang-chibi.png";
import enkidu from "@/assets/images/navigation/enkidu-chibi.png";

const [agentAvatar, terminalAvatar] = await Promise.all(
    [haiwenxiang, enkidu].map((src) => getImage({ src, width: 128, format: "webp", quality: 95 })),
);
---
<div class="terminal-companions" role="tablist" aria-label="Navigation mode">
    <button id="navigation-assistant-tab" class="navigation-mode-tab" type="button" role="tab" aria-label="Haiwenxiang · Agent" aria-selected="false" aria-controls="navigation-assistant-panel" tabindex="-1" data-navigation-mode="assistant" title="Haiwenxiang · Agent">
        <img class="navigation-mode-avatar" src={agentAvatar.src} width="36" height="36" alt="" aria-hidden="true" decoding="async" loading="eager" draggable="false" />
        <span>Agent</span>
    </button>
    <button id="navigation-terminal-tab" class="navigation-mode-tab" type="button" role="tab" aria-label="Enkidu · Terminal" aria-selected="true" aria-controls="navigation-terminal-panel" tabindex="0" data-navigation-mode="terminal" title="Enkidu · Terminal">
        <img class="navigation-mode-avatar" src={terminalAvatar.src} width="36" height="36" alt="" aria-hidden="true" decoding="async" loading="eager" draggable="false" />
        <span>Terminal</span>
    </button>
</div>
