---
import { getImage } from "astro:assets";
import garden from "@/assets/images/profile/byzantine-pixel-garden.png";
import kitchen from "@/assets/images/profile/scenes/kitchen-background.png";
import moonGarden from "@/assets/images/profile/scenes/moon-background.png";
import bubbles from "@/assets/images/profile/scenes/bubbles.png";
import tea from "@/assets/images/profile/scenes/tea-sipping.png";
import cooking from "@/assets/images/profile/scenes/cooking.png";
import moon from "@/assets/images/profile/scenes/moon.png";
import sleep from "@/assets/images/profile/scenes/sleep.png";
import gardening from "@/assets/images/profile/scenes/gardening.png";
import flute from "@/assets/images/profile/scenes/flute.png";
import type { GardenSceneId } from "@/utils/garden-companion-motion";

const [day, indoors, night] = await Promise.all(
  [garden, kitchen, moonGarden].map((src) => getImage({ src, width: 576, format: "webp", quality: 90 })),
);
const sources = { bubbles, tea, cooking, moon, sleep, gardening, flute };
const entries = await Promise.all(
  Object.entries(sources).map(async ([id, src]) => {
    const atlas = await getImage({ src, width: 1536, format: "webp", quality: 95 });
    const background = id === "cooking" ? indoors : id === "moon" ? night : day;
    return [id as GardenSceneId, {
      id,
      background: background.src,
      atlas: atlas.src,
      width: Number(atlas.attributes.width),
      height: Number(atlas.attributes.height),
    }] as const;
  }),
);
const assets = Object.fromEntries(entries);
const initial = assets.bubbles;
---
<garden-companion data-scene="bubbles" data-action="bubbles" data-posture="standing" data-reaction="none" data-frame="0" data-active="false" data-ready="false" role="img" aria-label="海问香在花园里吹泡泡">
  <script is:inline type="application/json" data-garden-assets set:html={JSON.stringify(assets)} />
  <img class="garden-scene" data-garden-scene src={initial.background} width={day.attributes.width} height={day.attributes.height} alt="" decoding="async" loading="eager" aria-hidden="true" />
  <span class="garden-shadow" aria-hidden="true"></span>
  <span class="garden-character" aria-hidden="true">
    <svg class="garden-frame-viewport" data-garden-frame viewBox={`0 0 ${initial.width / 4} ${initial.height / 2}`} preserveAspectRatio="xMidYMid meet" overflow="hidden" focusable="false">
      <image class="garden-atlas-image" data-garden-atlas href={initial.atlas} x="0" y="0" width={initial.width} height={initial.height} preserveAspectRatio="xMidYMid meet" />
    </svg>
  </span>
  <span class="garden-bubbles" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
</garden-companion>
<style>
  garden-companion { position: absolute; inset: 0; display: block; overflow: hidden; isolation: isolate; pointer-events: none; background: #618eaa; }
  .garden-scene { display: block; width: 100%; height: 100%; max-width: none; object-fit: cover; image-rendering: pixelated; }
  .garden-character { position: absolute; left: 7%; bottom: -1%; width: 86%; aspect-ratio: 1; transform-origin: 50% 95%; opacity: 0; transition: opacity 200ms ease; }
  garden-companion[data-ready="true"] .garden-character { opacity: 1; }
  .garden-frame-viewport { position: absolute; inset: 0; display: block; width: 100%; height: 100%; overflow: hidden; }
  .garden-atlas-image { image-rendering: pixelated; }
  .garden-shadow { position: absolute; left: 29%; bottom: 7%; width: 42%; height: 4%; background: #24334435; clip-path: polygon(8% 20%, 92% 20%, 92% 40%, 100% 40%, 100% 80%, 80% 80%, 80% 100%, 20% 100%, 20% 80%, 0 80%, 0 40%, 8% 40%); }
  .garden-bubbles { position: absolute; inset: 0; display: none; }
  garden-companion[data-action="bubbles"] .garden-bubbles { display: block; }
  .garden-bubbles i { position: absolute; left: 63%; top: 48%; width: 6px; height: 6px; border: 1px solid #d9f8ff; box-shadow: inset 1px 1px #ffc7ef, 1px 0 #72cfff; border-radius: 35%; opacity: 0; animation: garden-bubble 2600ms steps(18) infinite; }
  .garden-bubbles i:nth-child(2) { width: 4px; height: 4px; animation-delay: 650ms; --bubble-drift: 13px; }
  .garden-bubbles i:nth-child(3) { width: 8px; height: 8px; animation-delay: 1300ms; --bubble-drift: 22px; }
  .garden-bubbles i:nth-child(4) { animation-delay: 1950ms; --bubble-drift: -4px; }
  garden-companion[data-active="false"] *, garden-companion[data-active="false"] *::before { animation-play-state: paused !important; }
  @keyframes garden-bubble { 0% { transform: translate(0,0); opacity: 0; } 12% { opacity: .85; } 80% { opacity: .7; } 100% { transform: translate(var(--bubble-drift, 7px),-42px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .garden-character { transition: none; } garden-companion *, garden-companion *::before { animation: none !important; } }
</style>
<script>import "@/scripts/garden-companion";</script>
