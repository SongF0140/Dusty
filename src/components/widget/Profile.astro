---
import { Icon } from "astro-icon/components";
import ProfilePortrait from "./ProfilePortrait.astro";
import { profileConfig } from "@/config/profileConfig";
import { url } from "@/utils/url-utils";
---

<div class:list={["card-base profile-card p-3", Astro.props.class]} style={Astro.props.style}>
  <ProfilePortrait src={profileConfig.avatar} name={profileConfig.name} />
  <div class="px-2">
    <a href={url("/about/")} aria-label="关于作者" class="block font-bold text-xl text-center mb-1 dark:text-neutral-50 transition">{profileConfig.name}</a>
    <div class="h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"></div>
    <div class="text-center text-neutral-400 mb-2.5 transition">{profileConfig.bio}</div>
    <div class="flex flex-wrap gap-2 justify-center mb-1">
      {profileConfig.links.map(item => {
        const showName = item.showName || profileConfig.links.length === 1;
        const isWebLink = /^https?:\/\//.test(item.url);
        return (
          <a href={item.url} target={isWebLink ? "_blank" : undefined} rel={isWebLink ? "me noopener noreferrer" : "me"}
            data-swup-ignore aria-label={item.name} title={item.name}
            class:list={["btn-regular rounded-lg h-10 active:scale-95", showName ? "gap-2 px-3 font-bold" : "w-10"]}>
            <Icon is:inline name={item.icon} class="text-[1.5rem]" />
            {showName && item.name}
          </a>
        );
      })}
    </div>
  </div>
</div>