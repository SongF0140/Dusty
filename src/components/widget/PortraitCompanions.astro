<style>
  .portrait-companions { position: absolute; z-index: 2; width: min(160px, 78%); height: auto; left: 50%; top: 0; transform: translate(-50%, -79%); overflow: visible; pointer-events: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .paper, .bench { fill: var(--retro-surface); }
  .glove { fill: #fbf7eb; }
  .ink, .boots { fill: currentColor; }
  .chip-scarf { fill: #b87768; }
  .bottle-scarf { fill: #809cae; }
  .seated-friend { animation: bench-startle var(--portrait-cycle, 4s) linear infinite; }
  .talking-hand { transform-origin: 0 65px; animation: bench-conversation var(--portrait-cycle, 4s) ease-in-out infinite; }
  .bottle-friend .talking-hand { animation-direction: reverse; }
  .surprised-face, .startle-ticks { opacity: 0; animation: bench-surprised var(--portrait-cycle, 4s) steps(1) infinite; }
  .chat-mouth, .chat-ticks { animation: bench-smile var(--portrait-cycle, 4s) steps(1) infinite; }
  @keyframes bench-startle { 0%,89%,100% { transform: translateY(0); } 90% { transform: translateY(1px); } 93% { transform: translateY(-14px) rotate(-3deg); } 96% { transform: translateY(-8px) rotate(2deg); } 98% { transform: translateY(1px); } }
  @keyframes bench-conversation { 0%,36%,72%,89%,100% { transform: rotate(0); } 18%,54%,81% { transform: rotate(7deg); } 90%,98% { transform: rotate(-9deg); } }
  @keyframes bench-surprised { 0%,98%,100% { opacity: 0; } 90% { opacity: 1; } }
  @keyframes bench-smile { 0%,98%,100% { opacity: 1; } 90% { opacity: 0; } }
  :global(profile-portrait[data-flipped="true"]) .portrait-companions { visibility: hidden; }
  :global(profile-portrait[data-flipped="true"]) .portrait-companions * { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .portrait-companions * { animation: none; } }
</style>
