# GitHub 登录评论（Giscus）：先在 SongF0140/Dusty 开启 Discussions，
# 安装 https://github.com/apps/giscus，再从 https://giscus.app/zh-CN 获取分类配置。
# 以下都是公开配置，不需要放 GitHub token 或 client secret。
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOTBBh684DI0t3

# 海问香助手：仅在 Vercel 服务端配置，不加 PUBLIC_ 前缀。
# BASE_URL 填 API 根地址（通常以 /v1 结尾），不要填 /chat/completions。
BLOG_LLM_BASE_URL=
BLOG_LLM_MODEL=
BLOG_LLM_API_KEY=

# GitHub OAuth App: Homepage https://mjzy.tech; Callback https://mjzy.tech/api/blog-auth
BLOG_GITHUB_CLIENT_ID=
BLOG_GITHUB_CLIENT_SECRET=
# 至少 32 字符的随机密钥，只保存在服务端。
BLOG_SESSION_SECRET=
BLOG_SITE_URL=https://mjzy.tech

# 模型摘要在内容加载/构建时生成，访客打开文章不会请求模型。
# 首次使用 Neon 执行 migrations/003-seed-existing-summaries.sql（已含建表和现有简介）。
DATABASE_URL=
# true（默认）将旧简介重建为100字符内的 AI 摘要；新版摘要之后只在正文变化时更新。
# false 暂停生成，但仍可连接数据库并保存初始简介。
BLOG_SUMMARY_ENABLED=true
